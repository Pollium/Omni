{
  "name": "omni",
  "private": true,
  "scripts": {
    "infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev": "pnpm infra && pnpm --parallel --filter @omni/api --filter @omni/web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present --workspace-concurrency=1 test"
  }
}
